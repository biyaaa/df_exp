      "description": "存在KMT2A重排",
      "logic": "OR",
      "conditions": [
        {
          "field": "pcr.KMT2A_fusion",
          "operator": "is_positive",
          "value": null
        },
        {
          "field": "fish.KMT2A_rearrangement",
          "operator": "is_positive",
          "value": null
        }
      ]
    },
    {
      "id": "A059_E_noTx",
      "description": "无细胞毒性治疗暴露史",
      "logic": "OR",
      "conditions": [
        {
          "field": "judgment.no_cytotoxic_therapy_history",
          "operator": "is_true",
          "value": null
        },
        {
          "field": "basic.prior_cytotoxic_therapy",
          "operator": "is_negative",
          "value": null
        }
      ]
    }
  ],
  "desirable_criteria": [
    {
      "id": "A059_D1",
      "description": "鉴定KMT2A融合伴侣基因",
      "logic": "OR",
      "conditions": [
        {
          "field": "pcr.KMT2A_partner",
          "operator": "not_null",
          "value": null
        }
      ]
    }
  ]

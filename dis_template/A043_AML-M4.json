{
  "disease_code": "A043",
  "disease_name_en": "Acute myelomonocytic leukaemia",
  "disease_name_zh": "急性粒单核细胞白血病",
  "classes": "AML",
  "abbreviation": "AML-M4",
  "scoring_logic": "all_essential",
  "essential_criteria": [
    {
      "id": "A043_E1",
      "description": "骨髓和/或外周血中原始细胞及等同物（早幼单核细胞）≥20% \n 诊断用总原始细胞比例 = (原始粒细胞 + 原始单核细胞 + 其他原始细胞) + 幼稚单核细胞",
      "logic": "OR",
      "conditions": [
        {
          "field": "bma.blast_equivalents_pct",
          "operator": ">=",
          "value": 20
        },
        {
          "field": "pba.blast_equivalents_pct",
          "operator": ">=",
          "value": 20
        }
        


      ]
    },
    {
      "id": "A043_E2",
      "description": "髓系相关标记物阳性（MPO/CD13/CD33/CD117）",
      "logic": "OR",
      "conditions": [
        {
          "field": "judgment.myeloid_markers_positive",
          "operator": "is_true",
          "value": true
        }
      ]
    },
    {
      "id": "A043_E3",
      "description": "成熟中粒细胞占骨髓细胞≥20%",
      "logic": "OR",
      "conditions": [
        {
          "field": "bma.maturing_granulocytes_pct",
          "operator": ">=",
          "value": 20
        }
        
      ]
    },
    {
      "id": "A043_E4",
      "description": "单核系细胞占骨髓细胞≥20%",
      "logic": "OR",
      "conditions": [
        {
          "field": "bma.monocytic_lineage_pct",
          "operator": ">=",
          "value": 20
        },
        {
          "field": "judgment.monocytic_ge20pct",
          "operator": "is_true",
          "value": true
        }
      ]
    },
    {
      "id": "A043_E5",
      "description": "不满足伴定义性遗传学异常AML类型诊断标准",
      "logic": "OR",
      "conditions": [
        {
          "field": "judgment.no_AML_genetic_subtype",
          "operator": "is_true",
          "value": true
        }
      ]
    },
    {
      "id": "A043_E_noTx",
      "description": "无细胞毒性治疗暴露史",
      "logic": "OR",
      "conditions": [
        {
          "field": "judgment.no_cytotoxic_therapy_history",
          "operator": "is_true",
          "value": true
        },
        {
          "field": "basic.prior_cytotoxic_therapy",
          "operator": "is_negative",
          "value": true
        }
      ]
    }
  ]
}
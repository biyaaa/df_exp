{
  "disease_code": "A035",
  "disease_name_en": "Acute myeloid leukaemia with NPM1 mutation",
  "disease_name_zh": "NPM1突变AML",
  "abbreviation": "AML-NPM1",
  "scoring_logic": "all_essential",
  "essential_criteria": [
    {
      "id": "A035_E_blasts",
      "description": "外周血和/或骨髓原始细胞增多（可<20%）",
      "logic": "OR",
      "conditions": [
        {
          "field": "pba.blast_pct",
          "operator": ">",
          "value": 0
        },
        {
          "field": "bma.blast_pct",
          "operator": ">",
          "value": 0
        },
        {
          "field": "judgment.blasts_increased",
          "operator": "is_true",
          "value": null
        }
      ]
    },
    {
      "id": "A035_E2",
      "description": "检测到NPM1突变",
      "logic": "OR",
      "conditions": [
        {
          "field": "pcr.NPM1_mutation",
          "operator": "is_positive",
          "value": null
        }
      ]
    },
    {
      "id": "A035_E_noTx",
      "description": "无细胞毒性治疗暴露史",
      "logic": "OR",
      "conditions": [
        {
          "field": "judgment.no_cytotoxic_therapy_history",
          "operator": "is_true",
          "value": null
        },
        {
          "field": "basic.prior_cytotoxic_therapy",
          "operator": "is_negative",
          "value": null
        }
      ]
    }
  ],
  "desirable_criteria": [
    {
      "id": "A035_D1",
      "description": "免疫组化检测细胞质NPM1",
      "logic": "OR",
      "conditions": [
        {
          "field": "biopsy.cytoplasmic_NPM1_positive",
          "operator": "is_true",
          "value": null
        }
      ]
    }
  ]
}
{
  "disease_code": "A014",
  "disease_name_en": "Myelodysplastic neoplasm with low blasts and 5q deletion",
  "disease_name_zh": "伴5q缺失的低原始细胞骨髓增生异常肿瘤",
  "abbreviation": "MDS-5q",
  "scoring_logic": "all_essential",
  "essential_criteria": [
    {
      "id": "A014_E1",
      "description": "贫血，伴或不伴其他血细胞减少和/或血小板增多",
      "logic": "OR",
      "conditions": [
        {
          "field": "pba.anemia",
          "operator": "is_true",
          "value": null
        },
        {
          "field": "pba.HGB",
          "operator": "<",
          "value": 120
        }
      ]
    },
    {
      "id": "A014_E2",
      "description": "巨核细胞发育异常，伴或不伴其他细胞系发育异常",
      "logic": "OR",
      "conditions": [
        {
          "field": "bma.megakaryocytic_dysplasia",
          "operator": "is_true",
          "value": null
        }
      ]
    },
    {
      "id": "A014_E3",
      "description": "骨髓原始细胞<5%，外周血原始细胞<2%",
      "logic": "AND",
      "conditions": [
        {
          "field": "bma.blast_pct",
          "operator": "<",
          "value": 5
        },
        {
          "field": "pba.blast_pct",
          "operator": "<",
          "value": 2
        }
      ]
    },
    {
      "id": "A014_E4",
      "description": "检测到5q缺失（单独或伴除7号单体/7q缺失外的一种额外异常）",
      "logic": "OR",
      "conditions": [
        {
          "field": "fish.del_5q",
          "operator": "is_positive",
          "value": null
        },
        {
          "field": "caa.del_5q",
          "operator": "is_positive",
          "value": null
        },
        {
          "field": "judgment.del_5q_detected",
          "operator": "is_true",
          "value": null
        }
      ]
    },
    {
      "id": "A014_E5",
      "description": "不满足双等位TP53失活MDS、原始细胞增多MDS或MDS/MPN诊断标准",
      "logic": "OR",
      "conditions": [
        {
          "field": "judgment.no_biTP53_MDS_no_MDSIB_no_MDSMPH",
          "operator": "is_true",
          "value": null
        }
      ]
    }
  ],
  "desirable_criteria": [

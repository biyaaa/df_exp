{
  "disease_code": "A044",
  "disease_name_en": "Acute monocytic leukaemia",
  "disease_name_zh": "急性单核细胞白血病",
  "abbreviation": "AML-M5",
  "scoring_logic": "all_essential",
  "essential_criteria": [
    {
      "id": "A044_E1",
      "description": "骨髓和/或外周血原始细胞及等同物≥20%",
      "logic": "OR",
      "conditions": [
        {
          "field": "bma.blast_pct",
          "operator": ">=",
          "value": 20
        }
      ]
    },
    {
      "id": "A044_E2",
      "description": "白血病细胞≥80%为单核细胞及前体（原单核/早幼单核细胞）",
      "logic": "OR",
      "conditions": [
        {
          "field": "bma.monocyte_pct",
          "operator": ">=",
          "value": 80
        },
        {
          "field": "judgment.monocytic_ge80pct",
          "operator": "is_true",
          "value": null
        }
      ]
    },
    {
      "id": "A044_E3",
      "description": "成熟粒细胞<20%",
      "logic": "OR",
      "conditions": [
        {
          "field": "bma.neutrophil_granulocyte_pct",
          "operator": "<",
          "value": 20
        },
        {
          "field": "judgment.maturing_granulocytes_lt20pct",
          "operator": "is_true",
          "value": null
        }
      ]
    },
    {
      "id": "A044_E4",
      "description": "不满足伴定义性遗传学异常AML类型诊断标准",
      "logic": "OR",
      "conditions": [
        {
          "field": "judgment.no_AML_genetic_subtype",
          "operator": "is_true",
          "value": null
        }
      ]
    },
    {
      "id": "A044_E_noTx",
      "description": "无细胞毒性治疗暴露史",
      "logic": "OR",
      "conditions": [
        {
          "field": "judgment.no_cytotoxic_therapy_history",
          "operator": "is_true",
          "value": null
        },
        {
          "field": "basic.prior_cytotoxic_therapy",
          "operator": "is_negative",
          "value": null
        }
      ]
    }
  ]
}
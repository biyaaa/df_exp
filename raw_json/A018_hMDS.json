{
  "disease_code": "A018",
  "disease_name_en": "Myelodysplastic neoplasm, hypoplastic",
  "disease_name_zh": "低增生性骨髓增生异常肿瘤",
  "abbreviation": "hMDS",
  "scoring_logic": "all_essential",
  "essential_criteria": [
    {
      "id": "A018_E_cytopenia",
      "description": "一个或多个细胞系血细胞减少",
      "logic": "OR",
      "conditions": [
        {
          "field": "pba.anemia",
          "operator": "is_true",
          "value": null
        },
        {
          "field": "pba.thrombocytopenia",
          "operator": "is_true",
          "value": null
        },
        {
          "field": "judgment.leukocytopenia",
          "operator": "is_true",
          "value": null
        },
        {
          "field": "pba.HGB",
          "operator": "<",
          "value": 120
        },
        {
          "field": "pba.PLT",
          "operator": "<",
          "value": 100
        }
      ]
    },
    {
      "id": "A018_E2",
      "description": "低增生性骨髓（活检评估，根据年龄调整，非肿瘤性骨髓衰竭不能解释）",
      "logic": "OR",
      "conditions": [
        {
          "field": "biopsy.hypocellular",
          "operator": "is_true",
          "value": null
        },
        {
          "field": "judgment.hypocellular_bm",
          "operator": "is_true",
          "value": null
        }
      ]
    },
    {
      "id": "A018_E3",
      "description": "粒系和/或巨核系发育异常",
      "logic": "OR",
      "conditions": [
        {
          "field": "bma.granulocytic_dysplasia",
          "operator": "is_true",
          "value": null
        },
        {
          "field": "bma.megakaryocytic_dysplasia",
          "operator": "is_true",
          "value": null
        }
      ]
    },
    {
      "id": "A018_E4",
      "description": "骨髓原始细胞<5%，外周血原始细胞<2%",
      "logic": "AND",
      "conditions": [
        {
          "field": "bma.blast_pct",
          "operator": "<",
          "value": 5
        },
        {
          "field": "pba.blast_pct",
          "operator": "<",
          "value": 2
        }
      ]
    },
    {
      "id": "A018_E5",
      "description": "不满足伴定义性遗传学异常MDS或原始细胞增多MDS诊断标准",
      "logic": "OR",
      "conditions": [
        {
          "field": "judgment.no_defining_genetic_MDS_no_MDSIB",
          "operator": "is_true",
          "value": null
        }
      ]
    }
  ],
  "desirable_criteria": [
    {
      "id": "A018_D_clonal",
      "description": "检测到克隆性细胞遗传学和/或分子异常",
      "logic": "OR",
      "conditions": [
        {
          "field": "judgment.clonal_cytogenetic_molecular",
          "operator": "is_true",
          "value": null
        },
        {
          "field": "caa.clonal_abnormality",
          "operator": "is_positive",
          "value": null
        },
        {
          "field": "pcr.clonal_mutation",
          "operator": "is_true",
          "value": null
        }
      ]
    }
  ]
}
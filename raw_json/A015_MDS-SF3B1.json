{
  "disease_code": "A015",
  "disease_name_en": "Myelodysplastic neoplasm with low blasts and SF3B1 mutation",
  "disease_name_zh": "SF3B1突变伴低原始细胞骨髓增生异常肿瘤",
  "abbreviation": "MDS-SF3B1",
  "scoring_logic": "all_essential",
  "essential_criteria": [
    {
      "id": "A015_E1",
      "description": "一个或多个细胞系血细胞减少，不伴血小板增多",
      "logic": "AND",
      "conditions": [
        {
          "field": "pba.anemia",
          "operator": "is_true",
          "value": null
        },
        {
          "field": "pba.thrombocytosis",
          "operator": "is_negative",
          "value": null
        }
      ]
    },
    {
      "id": "A015_E2",
      "description": "红系发育异常",
      "logic": "OR",
      "conditions": [
        {
          "field": "bma.erythroid_dysplasia",
          "operator": "is_true",
          "value": null
        }
      ]
    },
    {
      "id": "A015_E3",
      "description": "骨髓原始细胞<5%，外周血原始细胞<2%",
      "logic": "AND",
      "conditions": [
        {
          "field": "bma.blast_pct",
          "operator": "<",
          "value": 5
        },
        {
          "field": "pba.blast_pct",
          "operator": "<",
          "value": 2
        }
      ]
    },
    {
      "id": "A015_E4",
      "description": "检测到SF3B1突变（或环形铁粒幼红细胞>15%替代）",
      "logic": "OR",
      "conditions": [
        {
          "field": "pcr.SF3B1_mutation",
          "operator": "is_positive",
          "value": null
        },
        {
          "field": "bma.ring_sideroblast_pct",
          "operator": ">",
          "value": 15
        }
      ]
    },
    {
      "id": "A015_E5",
      "description": "无5q缺失/7号单体/7q缺失/复杂核型",
      "logic": "OR",
      "conditions": [
        {
          "field": "judgment.no_del5q_no_mono7_no_complex_karyotype",
          "operator": "is_true",
          "value": null
        }
      ]
    },
    {
      "id": "A015_E6",
      "description": "不满足AML/MDS-5q/biTP53-MDS/MDS-IB/MDS-MPN诊断标准",
      "logic": "OR",
      "conditions": [
        {
          "field": "judgment.no_other_MDS_AML_criteria",
          "operator": "is_true",
          "value": null
        }
      ]
    }
  ]
}